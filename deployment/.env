export TF_VAR_cloudflare_account_id="op://tf/cloudflare/account_id"
export TF_VAR_cloudflare_api_token="op://tf/cloudflare/api_token"
export TF_VAR_tf_state_postgres_conn_str="op://tf/tf_state/postgres_conn_str"
export TF_VAR_env=$ENVIRONMENT

# survey.immich.app OIDC (Zitadel). Uncomment once the devtools Zitadel apply
# has created these items, and not before: `op run` aborts the whole command if
# any op:// reference cannot be resolved, and this file is shared by every app
# in the deploy matrix and by the destroy workflow — so referencing items that
# don't exist yet would fail all of them, not just survey.
#
# The items are written by
# devtools/tf/deployment/modules/shared/zitadel/cloud/project.tf from the
# "Survey" entry in local.projects_data (category `password`, hence /password).
#
# Until these are set the survey worker simply omits its OIDC bindings and
# keeps password auth, so merging the rest of the wiring ahead of time is safe.
# export TF_VAR_oidc_issuer="https://auth.internal.futo.org"
# export TF_VAR_oidc_client_id="op://tf/FUTO_ZITADEL_OAUTH_CLIENT_ID_SURVEY/password"
# export TF_VAR_oidc_client_secret="op://tf/FUTO_ZITADEL_OAUTH_CLIENT_SECRET_SURVEY/password"
