{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "survey-sessions",
  "main": "src/durable-objects/index.ts",
  "compatibility_date": "2025-06-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "SURVEY_SESSIONS",
        "class_name": "SurveyDO",
      },
    ],
  },
  // SurveyDO is the only Durable Object class and is SQLite-backed from the
  // start. Kept in sync with the Terraform migration (worker.tf) and
  // wrangler-dev.jsonc. The earlier v1 "SurveySession" class never existed.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SurveyDO"],
    },
  ],
}
