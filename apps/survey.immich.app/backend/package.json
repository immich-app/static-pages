{
  "name": "survey-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "build": "pnpm build:workers",
    "build:workers": "wrangler build --config wrangler-do.jsonc && mv dist/index.js dist/sessions.js && wrangler build",
    "start": "tsx src/server.ts",
    "build:node": "esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --external:better-sqlite3 --external:pg",
    "load-test": "tsx scripts/load-test.ts",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "hono": "^4.13.3",
    "tsx": "^4.23.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "itty-router": "^5.0.24",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0"
  }
}
