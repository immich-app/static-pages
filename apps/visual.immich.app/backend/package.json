{
  "name": "visual-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply visual --local && wrangler dev",
    "build": "wrangler build",
    "sync": "wrangler types --strict-vars=false",
    "check": "pnpm run sync && tsc --noEmit && tsc --noEmit -p test && sql-tools migrations verify-order --source-folder migrations",
    "test": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@immich/sql-tools": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.75.0"
  },
  "dependencies": {
    "@immich/kysely-adapter-cloudflare": "workspace:*",
    "hono": "^4.13.19",
    "kysely": "^0.29.0",
    "openid-client": "^6.9.0",
    "zod": "^4.6.7"
  }
}
