{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visual",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OAUTH_ISSUER": "https://auth.internal.futo.org",
    "OAUTH_CLIENT_ID": "",
    "OAUTH_CLIENT_SECRET": ""
  }
}
