{
  "name": "@immich/ui",
  "version": "0.91.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immich-app/static-pages.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "start": "pnpm run start:dev",
    "start:dev": "vite dev",
    "watch": "svelte-package --watch",
    "build": "pnpm package",
    "preview": "vite preview",
    "package": "svelte-package && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "sync": "svelte-kit sync",
    "test": "vitest"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./theme/default.css": "./dist/theme/default.css"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.13.0 || ^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/luxon": "^3.7.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.4.20",
    "globals": "^17.0.0",
    "publint": "^0.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.0",
    "@mdi/js": "^7.4.47",
    "bits-ui": "^2.15.7",
    "fuse.js": "^7.4.2",
    "luxon": "^3.7.2",
    "runed": "^0.35.1",
    "simple-icons": "^16.0.0",
    "svelte-highlight": "^7.8.4",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.0.0"
  },
  "volta": {
    "node": "24.21.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
